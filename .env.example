# DesignWear API settings (all optional in development).
PORT=8787
NODE_ENV=development

# REQUIRED in production: 32+ random characters (openssl rand -base64 32).
DESIGNWEAR_JWT_SECRET=
# REQUIRED in production: comma-separated web origins allowed to call the API.
ALLOWED_ORIGINS=
# URL that receives {to, subject, text} to send reset emails. Optional: without it
# password-reset emails are not sent (and the code is never logged in production).
MAIL_WEBHOOK_URL=
# Or send mail over SMTP directly (used instead of the webhook when SMTP_HOST is set).
# Port 465 is encrypted from the start; other ports (587) must offer STARTTLS.
# MAIL_FROM looks like: DesignWear <orders@your-domain>. Use a domain with SPF, DKIM and DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Shown at the bottom of receipts.
SUPPORT_EMAIL=
# debug | info | warning | error. Request lines below this level are dropped.
LOG_LEVEL=info
# Serverless database, option 0: SethuCMS itself (no other service needed). Create one collection
# (default `dw_store`) with three text fields: id (key), coll, data (long text). Give this
# token read-write access to that collection ONLY; it holds password hashes, so expose it to no one else.
SETHUCMS_STORE_TOKEN=
# SETHUCMS_STORE_COLLECTION=dw_store
# Serverless database, option 1: Firebase Firestore. Paste the service-account key JSON
# (Firebase console -> Project settings -> Service accounts), as text or base64.
FIREBASE_SERVICE_ACCOUNT=
# Option 2: Upstash Redis REST. Set these on Vercel and nothing is written to disk.
# Vercel'"'"'s Redis integration provides KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Without Redis: where accounts, carts, orders and designs are saved (single process).
DESIGNWEAR_DATA_FILE=./.data/store.json
# Set to 1 only behind a proxy you control (trusts X-Forwarded-For for rate limits).
TRUST_PROXY=

# Catalog: the SethuCMS gateway. Copy this file to .env (git-ignored, mode 600); the server
# loads it itself. The app never holds these. Use a READ-ONLY token for a connection that
# exposes only the products collection; the server prices orders from it.
SETHUCMS_URL=
SETHUCMS_CONNECTION_ID=
SETHUCMS_TOKEN=

# Optional: mirror orders into SethuCMS so the business sees them there (dashboards, status
# changes). Needs a SEPARATE token that can write only the `orders` collection.
SETHUCMS_ORDERS_TOKEN=
# SETHUCMS_ORDERS_COLLECTION=orders
# SETHUCMS_ORDERS_CONNECTION_ID=   # defaults to SETHUCMS_CONNECTION_ID

# Optional: phone notifications (Firebase Cloud Messaging). A service-account key for the
# Firebase project as base64 on ONE line:  base64 -w0 key.json   (Firebase console > Project
# settings > Service accounts > Generate new private key). Keep it secret.
FCM_SERVICE_ACCOUNT=
# Optional: tell customers the moment the business changes an order in SethuCMS. The whsec_
# secret SethuCMS shows once when you create the webhook (POST /v1/admin/webhooks) pointing
# at https://<your api>/v1/hooks/sethucms with events ["record.updated","record.created"].
SETHUCMS_WEBHOOK_SECRET=

# Optional: online payments (server side is ready; the app currently offers cash on delivery).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: AI via Google Gemini. The key lives only on this server, never in the app.
GEMINI_API_KEY=
# Chat model. Confirm the ID in Google AI Studio's model list.
GEMINI_MODEL=gemini-3.8-flash
# Virtual try-on must return an image; use a Gemini image-capable model.
GEMINI_IMAGE_MODEL=gemini-4-argon

# Google sign-in: the Firebase project whose ID tokens are accepted. Must match the
# app's FIREBASE_PROJECT_ID. Unset = POST /v1/auth/google answers 404.
FIREBASE_PROJECT_ID=
# Lets you create weekly challenges (PUT /v1/admin/challenges/:id). 24+ random characters.
# Unset = the admin routes do not exist.
DESIGNWEAR_ADMIN_TOKEN=
